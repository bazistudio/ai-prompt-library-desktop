{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Prompt Library",
  "version": "1.0.4",
  "identifier": "com.bazistudio.aipromptlibrary",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Prompt Library — Private AI Prompt Workspace",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1OUNCQ0IzMTk1N0JFMDUKUldRRnZsY1pzN3ljRldqYm9xeXhIRElKbkp5TTZhaEU3QS91NjBxQkRvUzhsb3c1bzExTVhuVWkK",
      "endpoints": [
        "https://github.com/bazistudio/ai-prompt-library-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
